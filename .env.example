# Este arquivo é só um MODELO. No dia a dia use o Infisical (npm run start:infisical); em último caso copie para .env.
# Não escreva segredos reais aqui.

# Porta do gateway (o servidor encaminha http://academico3.rj.senac.br/condominio/gateway para ela)
PORT=7521

# MESMO segredo usado pelo MS Moradores e pelos outros microsserviços para assinar/validar o token dos usuários.
JWT_SECRET=...

# Painel de cadastro de APIs: usuário, hash da senha e segredo PRÓPRIO do painel (diferente do JWT_SECRET).
#   gerar o hash:  npm run hash-senha
ADMIN_USUARIO=...
ADMIN_SENHA_HASH=...
ADMIN_JWT_SECRET=...

# Endereços INTERNOS dos serviços. Usados só na primeira subida, para já cadastrar as APIs; depois tudo é feito no painel.
# (o caminho base é opcional: o Financeiro atende em /condominio/financeiro)
MORADOR_API_URL=http://<IP-INTERNO>:7522
FINANCEIRO_API_URL=http://<IP-INTERNO>:7523/condominio/financeiro
SERVICOS_API_URL=

# Opcionais
# GATEWAY_PREFIXO=/condominio/gateway   (prefixo público que o gateway aceita receber ou não; padrão já é este)
# DATA_DIR=data                         (onde fica o apis.json; no Docker é o volume /app/data)
# PROXY_TIMEOUT_MS=30000
# ADMIN_TOKEN_EXPIRA=2h
